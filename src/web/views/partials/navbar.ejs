<header>
  <div class="container">
    <nav class="navbar">
      <a class="brand" href="/">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 3L2 9l10 6 8-4.8V17l2-1V8L12 3z" fill="rgba(255,255,255,0.85)" />
          <path d="M4 10v6l8 5 6-3.6V11l-6 3.6L4 10z" fill="rgba(255,255,255,0.6)" />
        </svg>
        Chat Filter
      </a>
      <div class="nav-links">
        <% if (isAuthenticated) { %>
          <a href="/dashboard">Sunucular</a>
        <% } %>
        <% if (isAuthenticated && user) { %>
          <div class="nav-user">
            <span><%= user.username %>#<%= user.discriminator %></span>
            <a class="button" href="/logout">Çıkış Yap</a>
          </div>
        <% } else { %>
          <a class="button" href="/auth/discord">Discord ile Giriş Yap</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>
