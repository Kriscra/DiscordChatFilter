<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= guild.name %> | Chat Filter Dashboard</title>
    <link rel="stylesheet" href="/static/css/main.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>
    <main>
      <div class="container">
        <section class="section">
          <div class="page-header">
            <h1 class="page-title"><%= guild.name %> Filtre Yönetimi</h1>
            <p class="page-subtitle">
              Sunucunuzdaki yasaklı kelimeleri tek yerden yönetin. Eklediğiniz
              veya kaldırdığınız her kelime bot ile anında senkronize edilir.
            </p>
          </div>
          <div class="surface-card manager-card">
            <% if (flashMessage) { %>
              <div class="message <%= flashType %>"><%= flashMessage %></div>
            <% } %>
            <% if (words.length) { %>
              <div class="words">
                <% words.forEach(function (word) { %>
                  <span class="chip"><%= word %></span>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty">Bu sunucu için kayıtlı kelime bulunmuyor.</div>
            <% } %>
            <form method="POST" action="/dashboard/<%= guild.id %>/words">
              <div class="row">
                <input
                  type="text"
                  name="word"
                  placeholder="Kelime"
                  maxlength="100"
                  required
                />
                <button class="button" type="submit" name="action" value="add">
                  Kelime Ekle
                </button>
                <button
                  class="button danger"
                  type="submit"
                  name="action"
                  value="remove"
                >
                  Kelime Çıkart
                </button>
              </div>
            </form>
            <div>
              <a class="button secondary" href="/dashboard">Sunuculara Dön</a>
            </div>
          </div>
        </section>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
