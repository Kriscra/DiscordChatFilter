<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chat Filter Dashboard</title>
    <link rel="stylesheet" href="/static/css/main.css" />
  </head>
  <body>
    <%- include('partials/navbar') %>
    <main>
      <div class="container">
        <section class="hero grid">
          <div>
            <h1>Discord Sunucularınızı Güvende Tutun</h1>
            <p>
              Chat Filter, sunucularınızdaki uygunsuz kelimeleri otomatik olarak
              engelleyerek moderasyon yükünüzü hafifletir.
            </p>
            <% if (isAuthenticated) { %>
              <a class="button" href="/dashboard">Sunucularımı Yönet</a>
            <% } else { %>
              <a class="button" href="/auth/discord">Discord ile Giriş Yap</a>
            <% } %>
          </div>
        </section>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
